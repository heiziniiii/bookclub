/* ===== ABOUT PAGE — 전용 스타일 ===== */

/* ── 컬러 토큰 오버라이드 ── */
:root {
  --bg-base:        #FAFAF8;
  --bg-elev:        #FFFFFF;
  --bg-soft:        #F3F1EA;
  --bg-dark:        #0A0A0A;
  --bg-glass:       rgba(250, 250, 248, 0.78);
  --text-primary:   #0A0A0A;
  --text-secondary: #555555;
  --text-muted:     #8A8A85;
  --text-on-dark:   #FAFAF8;
  --accent-green:   #2D5A3D;
  --accent-deep:    #1A3525;
  --accent-mint:    #C8E0CF;
  --accent-line:    rgba(0, 0, 0, 0.08);
}

/* 제목 계층: about 페이지는 serif 400 기반 */
.s-hero h1,
.s-values h2,
.s-members h2 {
  font-family: var(--font-serif);
  font-weight: 400;
  letter-spacing: -0.02em;
  line-height: var(--lh-tight);
}
.s-hero h1 em,
.s-values h2 em,
.s-members h2 em {
  font-family: var(--font-serif);
  font-style: italic;
  font-weight: 400;
}

/* ── 공통 콘텐츠 컨테이너 ── */
.about-inner {
  max-width: var(--max-w);
  margin: 0 auto;
  padding: 0 var(--gutter);
}

/* ── § 1 HERO ── */
.s-hero {
  background: var(--bg-elev);
  border-bottom: 1px solid var(--accent-line);
}
.s-hero .about-inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  height: 520px;
}
.hero-text {
  padding: 56px 0 48px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  border-right: 1px solid var(--accent-line);
}
.s-tag {
  font-family: var(--font-sans);
  font-size: var(--text-label);
  letter-spacing: 0.06em;
  color: var(--text-muted);
  margin-bottom: 30px;
  display: block;
  text-transform: uppercase;
}
.hero-h {
  font-family: var(--font-serif);
  font-size: clamp(42px, 5.5vw, 64px);
  font-weight: 400;
  letter-spacing: -0.02em;
  color: var(--text-primary);
  margin: 0 0 32px;
  line-height: var(--lh-tight);
}
.hero-h em { color: var(--accent-green); }
.hero-cap {
  font-size: var(--text-small);
  color: var(--text-muted);
  line-height: var(--lh-loose);
}
.hero-img-slot {
  overflow: hidden;
  background: var(--bg-soft);
  height: 100%;
}
.hero-img-slot img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* ── § 2 ORIGIN ── */
.s-origin {
  background: var(--bg-soft);
  border-bottom: 1px solid var(--accent-line);
}
.s-origin .about-inner {
  display: grid;
  grid-template-columns: 280px 1fr;
  min-height: 320px;
}
.origin-img-slot {
  overflow: hidden;
  background: var(--bg-elev);
  min-height: 280px;
}
.origin-img-slot img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.origin-body {
  padding: 48px 20px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 16px;
}
.origin-quote {
  font-family: var(--font-serif);
  font-size: clamp(22px, 2.8vw, 30px);
  font-style: italic;
  font-weight: 400;
  color: var(--text-primary);
  line-height: var(--lh-normal);
  letter-spacing: -0.02em;
  border-left: 3px solid var(--accent-green);
  padding-left: 22px;
  margin: 0;
}
.origin-attr {
  font-family: var(--font-sans);
  font-size: var(--text-label);
  letter-spacing: 0.06em;
  color: var(--accent-green);
  padding-left: 25px;
  text-transform: uppercase;
}
.origin-desc {
  font-size: var(--text-small);
  color: var(--text-secondary);
  line-height: var(--lh-loose);
  padding-left: 25px;
  margin: 0;
}

/* ── § 3 STATS ── */
.s-stats {
  background: var(--accent-deep);
  border-bottom: 1px solid rgba(0,0,0,0.2);
}
.s-stats .about-inner {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
}
.stat {
  padding: 40px 0;
  border-right: 1px solid rgba(255,255,255,0.1);
  text-align: center;
}
.stat:last-child { border-right: none; }
.stat-icon {
  margin-bottom: 4px;
  display: flex;
  justify-content: center;
}
.stat-n {
  font-family: var(--font-sans);
  font-size: clamp(40px, 4.5vw, 56px);
  font-weight: 400;
  color: var(--bg-elev);
  line-height: 1;
  margin-top: 5px;
  margin-bottom: 7px;
}
.stat-u {
  font-size: var(--text-heading);
  color: var(--accent-mint);
}
.stat-l {
  font-family: var(--font-sans);
  font-size: var(--text-label);
  color: var(--accent-mint);
  opacity: 0.7;
  margin-top: 5px;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

/* ── § 4 VALUES ── */
.s-values {
  background: var(--bg-elev);
  border-bottom: 1px solid var(--accent-line);
}
.s-values .about-inner {
  display: grid;
  grid-template-columns: 3fr 3fr;
}
.val-left {
  display: flex;
  flex-direction: column;
}
.val-head {
  padding: 32px 0 24px;
  border-bottom: 1px solid var(--accent-line);
  display: flex;
  align-items: baseline;
  gap: 14px;
}
.val-head-title {
  font-family: var(--font-serif);
  font-size: var(--text-display);
  font-weight: 400;
  color: var(--text-primary);
  letter-spacing: -0.02em;
}
.val-head-tag {
  font-family: var(--font-sans);
  font-size: var(--text-label);
  letter-spacing: 0.06em;
  color: var(--text-muted);
  text-transform: uppercase;
}
.val-row {
  display: grid;
  grid-template-columns: 52px 1fr;
  border-bottom: 1px solid var(--accent-line);
  flex: 1;
}
.val-row:last-child { border-bottom: none; }
.val-num {
  padding: 28px 0 26px;
  font-family: var(--font-sans);
  font-size: var(--text-label);
  color: var(--accent-green);
  font-weight: 500;
  border-right: 1px solid var(--accent-line);
  line-height: 1;
  display: flex;
  align-items: flex-start;
}
.val-body { padding: 26px; }
.val-title {
  font-size: var(--text-body);
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 4px;
}
.val-desc {
  font-size: var(--text-small);
  color: var(--text-muted);
  line-height: var(--lh-loose);
  margin: 0;
}
.val-img-slot {
  overflow: hidden;
  background: var(--bg-soft);
  height: 100%;
  border-left: 1px solid var(--accent-line);
}
.val-img-slot img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* ── § 5 MEMBERS ── */
.s-members {
  background: var(--accent-mint);
  border-bottom: 1px solid var(--accent-line);
}
.mem-head {
  padding: 32px 0 20px;
  border-bottom: 1px solid rgba(0,0,0,0.07);
  display: flex;
  align-items: baseline;
  gap: 14px;
}
.mem-head-title {
  font-family: var(--font-serif);
  font-size: var(--text-display);
  font-weight: 400;
  color: var(--accent-deep);
  letter-spacing: -0.02em;
}
.mem-head-tag {
  font-family: var(--font-sans);
  font-size: var(--text-label);
  letter-spacing: 0.06em;
  color: var(--accent-green);
  text-transform: uppercase;
}
.mem-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
}
.mem-card {
  border-right: 1px solid rgba(0,0,0,0.07);
  padding: 28px 16px 26px;
}
.mem-card:last-child { border-right: none; }
.mem-photo {
  width: 100%;
  aspect-ratio: 1 / 1;
  overflow: hidden;
  background: rgba(255,255,255,0.55);
  margin-bottom: 14px;
}
.mem-photo img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.mem-num {
  font-family: var(--font-sans);
  font-size: var(--text-label);
  color: var(--accent-green);
  letter-spacing: 0.06em;
  margin-bottom: 4px;
}
.mem-name {
  font-size: var(--text-body);
  font-weight: 500;
  color: var(--accent-deep);
  margin-bottom: 7px;
}
.mem-quote {
  font-family: var(--font-serif);
  font-size: var(--text-small);
  font-style: italic;
  font-weight: 400;
  color: var(--accent-green);
  line-height: var(--lh-normal);
}

/* ── § 6 CLOSING ── */
.s-close {
  background: var(--bg-soft);
  border-bottom: 1px solid var(--accent-line);
}
.s-close .about-inner {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 24px;
  padding: 48px var(--gutter);
}
.close-text {
  font-family: var(--font-serif);
  font-size: clamp(18px, 2.2vw, 22px);
  font-weight: 400;
  color: var(--text-primary);
  line-height: var(--lh-normal);
  letter-spacing: -0.02em;
}
.close-text em {
  font-family: var(--font-serif);
  font-style: italic;
  font-weight: 400;
  color: var(--accent-green);
}
.close-btn {
  flex-shrink: 0;
  padding: 12px 26px;
  border: 1.5px solid var(--accent-green);
  border-radius: 2px;
  font-family: var(--font-sans);
  font-size: var(--text-label);
  letter-spacing: 0.06em;
  color: var(--accent-green);
  text-decoration: none;
  white-space: nowrap;
  transition: background 0.18s, color 0.18s;
}
.close-btn:hover {
  background: var(--accent-green);
  color: var(--text-on-dark);
}

/* ── FOOTER DARK OVERRIDE ── */
.footer-dark {
  background: var(--bg-dark);
  border-top: none;
}
.footer-dark .footer-content { color: rgba(244,239,230,0.45); }
.footer-dark .footer-meta strong { color: rgba(244,239,230,0.75); }
.footer-dark .footer-right a { color: rgba(244,239,230,0.45); }
.footer-dark .footer-right a:hover { color: var(--text-on-dark); }

/* ── RESPONSIVE ── */

@media (max-width: 768px) {
  .s-hero .about-inner {
    grid-template-columns: 1fr;
    height: auto;
  }
  .hero-text { border-right: none; border-bottom: 1px solid var(--accent-line); }
  .hero-img-slot { height: 280px; }

  .s-origin .about-inner { grid-template-columns: 1fr; }
  .origin-img-slot { min-height: 220px; }

  .s-values .about-inner { grid-template-columns: 1fr; }
  .val-img-slot { min-height: 220px; border-left: none; border-top: 1px solid var(--accent-line); }

  .mem-grid { grid-template-columns: repeat(2, 1fr); }
  .mem-card:nth-child(2n) { border-right: none; }
  .mem-card:nth-child(n+3) { border-top: 1px solid rgba(0,0,0,0.07); }

  .mem-card:last-child:nth-child(odd) {
    grid-column: 1 / -1;
    border-right: none;
    padding: 28px calc(25% + 16px) 26px;
    text-align: center;
  }

  .s-close .about-inner { flex-direction: column; align-items: flex-start; }
}

@media (max-width: 480px) {
  :root { --gutter: 20px; }
  .s-stats .about-inner { grid-template-columns: repeat(2, 1fr); }
  .stat:nth-child(2n) { border-right: none; }
  .stat:nth-child(n+3) { border-top: 1px solid rgba(255,255,255,0.1); }
  .hero-text { padding: 40px 0 36px; }
  .origin-body { padding: 36px 12px; }
  .val-head { padding: 24px 0 16px; }
  .mem-head { padding: 24px 0 16px; }
}
