<script>
  function toggleNav(btn) {
    const nav = document.getElementById('primary-nav');
    const open = nav.classList.toggle('open');
    btn.setAttribute('aria-expanded', String(open));
  }

  // Hero video fade-in on scroll
  (function () {
    const target = document.getElementById('hero-video');
    if (!target) return;
    if (!('IntersectionObserver' in window)) {
      target.classList.add('in-view');
      return;
    }
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          target.classList.add('in-view');
          io.disconnect();
        }
      });
    }, { threshold: 0.15 });
    io.observe(target);
  })();

  // Quotes Carousel — 5개 중 3개(top/mid/bot) 순환
  (function () {
    const stage = document.querySelector('.quotes-stage');
    if (!stage) return;
    const bubbles = Array.from(stage.querySelectorAll('.quote-bubble'));
    if (bubbles.length < 3) return;
    const VISIBLE = ['pos-top', 'pos-mid', 'pos-bot'];
    const ALL_POS = [...VISIBLE, 'pos-hidden'];
    const prefersReduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let state = 0;

    function applyState(s) {
      const n = bubbles.length;
      bubbles.forEach(b => ALL_POS.forEach(p => b.classList.remove(p)));
      for (let j = 0; j < 3; j++) {
        bubbles[(s + j) % n].classList.add(VISIBLE[j]);
      }
      for (let j = 3; j < n; j++) {
        bubbles[(s + j) % n].classList.add('pos-hidden');
      }
    }

    applyState(state);
    if (prefersReduce) return;

    let timer = null;
    function start() {
      timer = setInterval(() => {
        state = (state + 1) % bubbles.length;
        applyState(state);
      }, 2000);
    }
    function stop() { if (timer) { clearInterval(timer); timer = null; } }
    start();
    stage.addEventListener('mouseenter', stop);
    stage.addEventListener('mouseleave', start);
  })();

</script>

<script type="module">
import { initializeApp, getApps } from "https://www.gstatic.com/firebasejs/10.13.0/firebase-app.js";
import { getDatabase, ref, push, onValue } from "https://www.gstatic.com/firebasejs/10.13.0/firebase-database.js";

const firebaseConfig = {
  apiKey: "AIzaSyCjtgMykJPKnsAORcfgQ9FxbPnzNEj_fEc",
  authDomain: "book-56493.firebaseapp.com",
  databaseURL: "https://book-56493-default-rtdb.asia-southeast1.firebasedatabase.app",
  projectId: "book-56493",
  storageBucket: "book-56493.firebasestorage.app",
  messagingSenderId: "900836361804",
  appId: "1:900836361804:web:17d21b68011427a7e796e9"
};

const app = getApps().length ? getApps()[0] : initializeApp(firebaseConfig);
const db = getDatabase(app);
const appsRef = ref(db, "book-club/applications");

// ── 다음 모임 실시간 표시 ──────────────────────────────────
const DAY_NAMES_KO = ["일","월","화","수","목","금","토"];
onValue(ref(db, "book-club/confirmed-meeting"), (snap) => {
  if (!snap.exists()) return;
  const { date, time, place, count } = snap.val();

  const d = new Date(date);
  // 날짜 포맷: 2026.05.14 형식
  const dateStr = `${d.getFullYear()}.${String(d.getMonth()+1).padStart(2,'0')}.${String(d.getDate()).padStart(2,'0')}`;

  const dateEl   = document.querySelector(".nm-date");
  const captionEl = document.querySelector(".nm-caption");
  const countEl  = document.querySelector(".nm-members .count");

  if (dateEl)   dateEl.textContent = dateStr;
  if (captionEl) captionEl.textContent = `${time} · ${place}`;
  if (countEl && count) countEl.textContent = count;
});

// 인라인 Auth (세션 표시 전용)
const SK = "gonggan-session";
function getSession(){ try{const r=sessionStorage.getItem(SK);return r?JSON.parse(r):null;}catch{return null;} }
function isAdmin(){ const s=getSession();return !!(s&&s.role==="admin"); }

const adminLink = document.getElementById("nav-admin");
if (adminLink) adminLink.style.display = isAdmin() ? "" : "none";

(function renderAuthBadge(){
  const s = getSession();
  const b = document.getElementById("auth-badge");
  if (!b) return;
  if (s) {
    b.innerHTML = `<span style="font-size:13px;font-weight:500;color:#2D5A3D">${s.member}${s.role==="admin"?" · 관리자":""}</span><button onclick="sessionStorage.removeItem('${SK}');location.reload();" style="margin-left:8px;font-size:12px;color:#999993;border:1px solid rgba(45,90,61,.12);border-radius:999px;padding:4px 12px;background:none;cursor:pointer;font-family:inherit">로그아웃</button>`;
  } else {
    b.innerHTML = `<a href="schedule.html?login=1" style="font-size:13px;font-weight:500;color:#2D5A3D;border:1px solid rgba(45,90,61,.3);border-radius:999px;padding:6px 16px;text-decoration:none">로그인</a>`;
  }
})();

// 신청 폼 토글
const toggleBtn = document.getElementById("apply-toggle-btn");
const applyForm = document.getElementById("join-apply-form");
if (toggleBtn && applyForm) {
  toggleBtn.addEventListener("click", () => {
    applyForm.classList.toggle("open");
    if (applyForm.classList.contains("open")) {
      toggleBtn.textContent = "닫기 ×";
      document.getElementById("apply-name").focus();
    } else {
      toggleBtn.innerHTML = "멤버 신청하기 <span class='arrow'>→</span>";
    }
  });
}

// 신청 제출
const submitBtn = document.getElementById("apply-submit-btn");
if (submitBtn) {
  submitBtn.addEventListener("click", async () => {
    const name    = document.getElementById("apply-name").value.trim();
    const contact = document.getElementById("apply-contact").value.trim();
    const genre   = document.getElementById("apply-genre").value;
    const intro   = document.getElementById("apply-intro").value.trim();

    if (!name || !contact || !genre) {
      alert("이름, 연락처, 장르는 필수 항목이에요.");
      return;
    }

    submitBtn.textContent = "제출 중...";
    submitBtn.disabled = true;

    try {
      await push(appsRef, {
        name, contact, genre, intro,
        at: new Date().toISOString()
      });
      applyForm.innerHTML = `<p class="apply-success">✦ 신청이 접수됐어요.<br>관리자 확인 후 연락드릴게요.</p>`;
    } catch {
      submitBtn.textContent = "신청하기";
      submitBtn.disabled = false;
      alert("제출 중 오류가 발생했어요. 다시 시도해주세요.");
    }
  });
}
</script>

</body>
</html>
